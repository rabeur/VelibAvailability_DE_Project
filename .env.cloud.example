# Copy to .env.cloud and fill in. Never commit .env.cloud.

# GCP project
GCP_PROJECT_ID=velib-analytics-xxxxx
GCP_REGION=europe-west1

# Storage
GCP_BRONZE_BUCKET=velib-bronze-velib-analytics-xxxxx

# BigQuery (dataset names land in the dbt `schema` field on the BQ side)
GCP_BIGQUERY_SILVER_DATASET=velib_silver
GCP_BIGQUERY_GOLD_DATASET=velib_gold

# Service account key path (JSON) — keep outside the repo
GCP_SERVICE_ACCOUNT_KEY=/absolute/path/to/velib-pipeline-sa.json

# Dataproc Serverless execution identity. When unset, the batch runs as
# the Compute Engine default SA, which requires extra IAM grants the
# keyfile SA does not have. Setting it to velib-pipeline-sa keeps every
# permission inside the SA we already provisioned in terraform.
GCP_DATAPROC_SERVICE_ACCOUNT=velib-pipeline-sa@velib-analytics-xxxxx.iam.gserviceaccount.com

# Pipeline mode switch used by Airflow DAGs and Spark jobs
# PIPELINE_TARGET=cloud
