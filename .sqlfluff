[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 100
exclude_rules = LT05

[sqlfluff:templater:jinja:context]
project_name = velib_dbt
# Fake `target` exposed so cross-engine macros that branch on `target.type`
# render to the Postgres side during static linting.
target = {"type": "postgres"}
